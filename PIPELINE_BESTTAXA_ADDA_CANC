# BESTTAXA analysis in RStudio

Load the required R packages:

```r
library(readr)
library(dplyr)
library(stringr)

# ---- PacBio-style settings ----
min_conf <- 0.8
priority <- c("GG2", "GTDB", "SILVA")

# This order follows the PacBio default.
# To use a different priority, change the order above.

# ---- Read taxonomy files ----
gg2   <- read_tsv("taxonomy_gg2.tsv", show_col_types = FALSE)
gtdb  <- read_tsv("taxonomy_GTDB.tsv", show_col_types = FALSE)
silva <- read_tsv("taxonomy_silva.tsv", show_col_types = FALSE)

fix_id <- function(df) {
  if ("Feature ID" %in% names(df)) {
    df <- df %>% rename(FeatureID = `Feature ID`)
  }
  df
}

gg2   <- fix_id(gg2)
gtdb  <- fix_id(gtdb)
silva <- fix_id(silva)

gg2 <- gg2 %>%
  select(FeatureID, Taxon, Confidence) %>%
  rename(
    Taxon_GG2 = Taxon,
    Conf_GG2 = Confidence
  )

gtdb <- gtdb %>%
  select(FeatureID, Taxon, Confidence) %>%
  rename(
    Taxon_GTDB = Taxon,
    Conf_GTDB = Confidence
  )

silva <- silva %>%
  select(FeatureID, Taxon, Confidence) %>%
  rename(
    Taxon_SILVA = Taxon,
    Conf_SILVA = Confidence
  )

m <- gg2 %>%
  full_join(gtdb, by = "FeatureID") %>%
  full_join(silva, by = "FeatureID")

# ---- Helper functions ----
# Determine whether the classification reaches a valid species or genus level

has_species <- function(t) {
  !is.na(t) & str_detect(t, "s__") & !str_detect(t, "s__$")
}

has_genus <- function(t) {
  !is.na(t) & str_detect(t, "g__") & !str_detect(t, "g__$")
}

# ---- Priority-based selector ----

pick_by_priority <- function(row, want = c("species", "genus")) {
  want <- match.arg(want)

  for (db in priority) {
    tax <- row[[paste0("Taxon_", db)]]
    cf  <- row[[paste0("Conf_", db)]]

    if (is.na(tax) || is.na(cf) || cf < min_conf) next

    if (want == "species" && has_species(tax)) {
      return(list(
        Source = db,
        Taxon = tax,
        Confidence = cf
      ))
    }

    if (want == "genus" && has_genus(tax)) {
      return(list(
        Source = db,
        Taxon = tax,
        Confidence = cf
      ))
    }
  }

  return(list(
    Source = NA_character_,
    Taxon = NA_character_,
    Confidence = NA_real_
  ))
}

# ---- PacBio-style BESTTAXA: species -> genus -> fallback ----

out <- m %>%
  rowwise() %>%
  mutate(
    pick_species = list(pick_by_priority(cur_data(), "species")),
    Source = pick_species$Source,
    Taxon = pick_species$Taxon,
    Confidence = pick_species$Confidence,

    # If no species-level classification is available,
    # attempt classification at the genus level
    pick_genus = if (is.na(Source)) {
      list(pick_by_priority(cur_data(), "genus"))
    } else {
      list(NULL)
    },

    Source = if (is.na(Source)) pick_genus$Source else Source,
    Taxon = if (is.na(Taxon)) pick_genus$Taxon else Taxon,
    Confidence = if (is.na(Confidence)) {
      pick_genus$Confidence
    } else {
      Confidence
    }
  ) %>%
  ungroup() %>%
  select(
    `Feature ID` = FeatureID,
    Taxon,
    Confidence,
    Source
  )

# ---- Final fallback ----
# If the confidence threshold produced NA values, use the best available
# classification without applying the threshold. This prevents ASVs from
# being lost because of an overly strict confidence threshold.

fallback <- m %>%
  mutate(
    level = pmax(
      ifelse(
        !is.na(Taxon_GG2) & str_detect(Taxon_GG2, "s__"),
        7L,
        ifelse(
          !is.na(Taxon_GG2) & str_detect(Taxon_GG2, "g__"),
          6L,
          0L
        )
      ),
      ifelse(
        !is.na(Taxon_GTDB) & str_detect(Taxon_GTDB, "s__"),
        7L,
        ifelse(
          !is.na(Taxon_GTDB) & str_detect(Taxon_GTDB, "g__"),
          6L,
          0L
        )
      ),
      ifelse(
        !is.na(Taxon_SILVA) & str_detect(Taxon_SILVA, "s__"),
        7L,
        ifelse(
          !is.na(Taxon_SILVA) & str_detect(Taxon_SILVA, "g__"),
          6L,
          0L
        )
      )
    )
  )

# Fill NA values using the best available classification according to
# database priority, without applying a confidence threshold

fix_na <- function(row) {
  if (!is.na(row$Taxon)) return(row)

  # Build the list of candidates according to the established priority
  for (db in priority) {
    tax <- row[[paste0("Taxon_", db)]]
    cf  <- row[[paste0("Conf_", db)]]

    if (!is.na(tax)) {
      return(list(
        Taxon = tax,
        Confidence = cf,
        Source = paste0(db, "_fallback")
      ))
    }
  }

  return(list(
    Taxon = NA_character_,
    Confidence = NA_real_,
    Source = NA_character_
  ))
}

# Apply the fallback

na_idx <- which(is.na(out$Taxon))

if (length(na_idx) > 0) {
  fb_rows <- fallback[na_idx, ]

  fb <- lapply(
    seq_len(nrow(fb_rows)),
    function(i) fix_na(fb_rows[i, ])
  )

  out$Taxon[na_idx] <- sapply(fb, `[[`, "Taxon")
  out$Confidence[na_idx] <- as.numeric(
    sapply(fb, `[[`, "Confidence")
  )
  out$Source[na_idx] <- sapply(fb, `[[`, "Source")
}

write_tsv(
  out,
  "taxonomy_besttax_PACBIO_like_GG2_GTDB_SILVA.tsv"
)

cat("Saved: taxonomy_besttax_PACBIO_like_GG2_GTDB_SILVA.tsv\n")

cat("\n--- Database used as the source ---\n")
print(out %>% count(Source, sort = TRUE))

cat("\n--- Percentage classified at the species level (s__) ---\n")
cat(
  sprintf(
    "%.2f%%\n",
    mean(str_detect(out$Taxon, "s__"), na.rm = TRUE) * 100
  )
)
```

# Taxonomic Assignment Methodology

The “best taxonomy” approach implemented in this repository was inspired by the strategy used in PacBio’s HiFi-16S-workflow (Pacific Biosciences). This approach prioritizes taxonomic classification using three reference databases in the following order:

**Greengenes2 → GTDB → SILVA**

Taxonomic resolution is first evaluated at the species level. If species-level classification cannot be achieved, the classification is evaluated at the genus level.

## Reference

Pacific Biosciences. *HiFi-16S-workflow*.  
https://github.com/PacificBiosciences/HiFi-16S-workflow

# Databases and Classifiers Used

- **Greengenes2:** `gg2_2024.09_full_length_classifier.qza` (release 2024.09)
- **GTDB:** `gtdb_human_stool_weighted_classifier_r220.qza` (release r220, weighted for human stool samples)
- **SILVA:** `silva-138-99-nb-classifier.qza` (SILVA 138, 99% OTUs)
- Taxonomic classification was performed with QIIME 2 using `qiime feature-classifier classify-sklearn`.

